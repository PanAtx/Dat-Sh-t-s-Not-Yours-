#!/bin/sh
# ============================================================================
# DSNYBoy pre-commit hook: keep the app version in lockstep on every commit.
#
#  - If this commit ALREADY carries a version change (a manual bump), keep it
#    as-is and just verify every version point agrees with it.
#  - Otherwise bump PATCH, so the bump is part of the commit (a new version ->
#    a new dsnboy-shell-v* SW cache -> installed PWA clients update).
#
# Only touches the version when app files (index.html/manifest.json/sw.js) are
# actually in the commit, so pure-doc commits don't churn the version.
# Install (once, per machine): git config core.hooksPath hooks
# Skip for one commit:         git commit --no-verify
# ============================================================================

# Only act when app files are in this commit (so pure-doc commits don't churn).
CHANGED=$(git diff --cached --name-only -- index.html manifest.json sw.js 2>/dev/null)
if [ -z "$CHANGED" ]; then
  exit 0
fi

# Resolve the repo root so the hook works regardless of where git invokes it.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$ROOT" ]; then
  echo "pre-commit: could not resolve repo root; skipping version bump"
  exit 0
fi

BUMP="$ROOT/scripts/bump-version.js"
if [ ! -f "$BUMP" ]; then
  echo "pre-commit: $BUMP not found; skipping version bump"
  exit 0
fi

command -v node >/dev/null 2>&1 || { echo "pre-commit: node not found; skipping version bump"; exit 0; }

# Detect a manual bump: is the STAGED index.html version different from HEAD's?
# If it is, this commit already carries a version change - keep it and just
# verify every version point agrees, instead of bumping on top of it.
staged_ver=$(git show :index.html 2>/dev/null | grep -Eo "const APP_VERSION = '[0-9]+\.[0-9]+\.[0-9]+'" | grep -Eo "[0-9]+\.[0-9]+\.[0-9]+" | head -n 1)
head_ver=$(git show HEAD:index.html 2>/dev/null | grep -Eo "const APP_VERSION = '[0-9]+\.[0-9]+\.[0-9]+'" | grep -Eo "[0-9]+\.[0-9]+\.[0-9]+" | head -n 1)

if [ -n "$staged_ver" ] && [ "$staged_ver" != "$head_ver" ]; then
  # A manual bump is already in this commit - keep it, just verify all points agree.
  echo "pre-commit: manual version bump detected ($head_ver -> $staged_ver); validating"
  node "$BUMP" check || exit 1
else
  # No version change in this commit - bump PATCH and re-stage the version files.
  OUT=$(node "$BUMP" patch 2>&1)
  if [ $? -ne 0 ]; then
    echo "pre-commit: version bump failed:"
    echo "$OUT"
    exit 1
  fi
  echo "pre-commit: $OUT"
  # Re-stage the files the bump touched so the new version is in the commit.
  git add index.html manifest.json sw.js 2>/dev/null || true
fi
exit 0