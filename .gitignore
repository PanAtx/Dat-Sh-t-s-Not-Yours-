# Node.js (used only by the fbx_*.mjs verification scripts, not by the browser)
node_modules/
package-lock.json

# downloaded three r128 build (auto-fetched by the dev verify scripts)
_three128.js
# three_r128.min.js IS SHIPPED: index.html injects it when the cdnjs build misses
